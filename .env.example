# =============================================================================
# PROYECTO CHARO - ENVIRONMENT VARIABLES
# =============================================================================
# Copia este archivo a .env y rellena con tus valores reales
# NUNCA commitees el archivo .env al repositorio
# =============================================================================

# -----------------------------------------------------------------------------
# General Configuration
# -----------------------------------------------------------------------------
PROJECT_NAME="Proyecto Charo"
VERSION="1.0.0-alpha"
ENVIRONMENT="development"  # development, staging, production
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------
# IPs de las Raspberry Pi
PI4_HOST="192.168.1.100"  # Audio Node
PI5_HOST="192.168.1.101"  # Main Node

# Puertos de servicios
CHARO_CORE_PORT="8080"
AUDIO_SERVICE_PORT="8081"
WEBSOCKET_PORT="8082"
HOME_ASSISTANT_PORT="8123"
POSTGRES_PORT="5432"
REDIS_PORT="6379"

# -----------------------------------------------------------------------------
# Home Assistant Configuration
# -----------------------------------------------------------------------------
HOME_ASSISTANT_URL="http://192.168.1.101:8123"
HOME_ASSISTANT_TOKEN="your_long_lived_access_token_here"
# Crear token en: Perfil > Seguridad > Tokens de larga duración

# Coordenadas (para Home Assistant)
HOME_LATITUDE="40.4168"
HOME_LONGITUDE="-3.7038"
HOME_ELEVATION="667"
HOME_TIMEZONE="Europe/Madrid"

# -----------------------------------------------------------------------------
# RunPod Configuration
# -----------------------------------------------------------------------------
RUNPOD_API_KEY="your_runpod_api_key_here"
RUNPOD_ENDPOINT_ID="your_endpoint_id_here"
RUNPOD_WHISPER_ENDPOINT="https://api.runpod.ai/v2/your-whisper-endpoint"
RUNPOD_LLM_ENDPOINT="https://api.runpod.ai/v2/your-llm-endpoint"

# Model configuration
WHISPER_MODEL="medium"
WHISPER_LANGUAGE="es"
LLM_MODEL="TheBloke/Mistral-7B-Instruct-v0.2-GGUF"
LLM_QUANTIZATION="Q4_K_M"

# RunPod timeouts (milliseconds)
RUNPOD_TIMEOUT="30000"
RUNPOD_RETRY_ATTEMPTS="3"

# -----------------------------------------------------------------------------
# Smart Home Devices - Xiaomi
# -----------------------------------------------------------------------------
# Obtener token: https://github.com/PiotrMachowski/Xiaomi-cloud-tokens-extractor
XIAOMI_BULB_HOST="192.168.1.110"
XIAOMI_BULB_TOKEN="your_xiaomi_token_32_chars_here"
XIAOMI_BULB_MODEL="yeelink.light.color2"

# -----------------------------------------------------------------------------
# Smart Home Devices - Tuya/Antela
# -----------------------------------------------------------------------------
# Obtener credenciales en: https://iot.tuya.com/
TUYA_USERNAME="your_tuya_email@example.com"
TUYA_PASSWORD="your_tuya_password"
TUYA_COUNTRY_CODE="34"  # España: 34
TUYA_PLATFORM="smart_life"  # smart_life o tuya

# Device IDs (opcional, para configuración avanzada)
TUYA_BULB_1_ID=""
TUYA_BULB_2_ID=""

# -----------------------------------------------------------------------------
# Smart Home Devices - Sony TV
# -----------------------------------------------------------------------------
SONY_TV_HOST="192.168.1.120"
# Obtener PSK: Configuración > Red > Inicio de sesión simple de IP
SONY_TV_PSK="your_sony_tv_psk_here"
SONY_TV_NAME="TV Sony"

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_DB="charo_db"
POSTGRES_USER="charo_user"
POSTGRES_PASSWORD="change_this_secure_password_123"

# Connection pool
POSTGRES_POOL_SIZE="10"
POSTGRES_MAX_OVERFLOW="20"

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""  # Dejar vacío si no usas password
REDIS_DB="0"

# Cache TTL (seconds)
CACHE_TTL_COMMANDS="3600"  # 1 hora
CACHE_TTL_RESPONSES="86400"  # 24 horas
CACHE_TTL_DEVICE_STATE="300"  # 5 minutos

# -----------------------------------------------------------------------------
# Audio Configuration
# -----------------------------------------------------------------------------
# Micrófono (Pi4)
AUDIO_INPUT_DEVICE="USB Webcam"
AUDIO_SAMPLE_RATE="16000"
AUDIO_CHANNELS="1"
AUDIO_GAIN="1.5"

# Altavoz Bluetooth (Pi4)
BLUETOOTH_SPEAKER_MAC="00:11:22:33:44:55"  # MAC de UE BOOM 2
BLUETOOTH_SPEAKER_NAME="UE BOOM 2"
AUDIO_OUTPUT_DEVICE="bluez_sink.UE_BOOM_2"

# -----------------------------------------------------------------------------
# Wake Word Configuration
# -----------------------------------------------------------------------------
WAKE_WORD_PHRASE="oye charo"
WAKE_WORD_THRESHOLD="0.5"  # 0.3-0.7 (mayor = menos sensible)
WAKE_WORD_MODEL_PATH="/app/models/wake_word.onnx"

# -----------------------------------------------------------------------------
# Voice Activity Detection (VAD)
# -----------------------------------------------------------------------------
VAD_THRESHOLD="0.5"
VAD_MIN_SPEECH_DURATION="0.25"  # segundos
VAD_MIN_SILENCE_DURATION="1.5"  # segundos
VAD_WINDOW_SIZE="512"

# -----------------------------------------------------------------------------
# Text-to-Speech (Piper)
# -----------------------------------------------------------------------------
TTS_MODEL="es_ES-davefx-medium"
TTS_SPEAKER="0"
TTS_SPEED="1.0"
TTS_NOISE_SCALE="0.667"
TTS_LENGTH_SCALE="1.0"

# -----------------------------------------------------------------------------
# Intent Recognition
# -----------------------------------------------------------------------------
INTENT_CONFIDENCE_THRESHOLD="0.7"
ENABLE_LLM_FALLBACK="true"
ENABLE_LOCAL_CACHE="true"

# -----------------------------------------------------------------------------
# Telemetry and Monitoring
# -----------------------------------------------------------------------------
ENABLE_TELEMETRY="true"
TELEMETRY_ENDPOINT=""  # Opcional: endpoint externo para métricas
SENTRY_DSN=""  # Opcional: para error tracking

# Performance targets
TARGET_WAKE_WORD_ACCURACY="0.95"
TARGET_TOTAL_LATENCY="3.0"  # segundos
TARGET_INTENT_PRECISION="0.90"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# JWT para autenticación entre servicios (generar con: openssl rand -hex 32)
JWT_SECRET="change_this_to_a_random_64_character_hex_string_here"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION="3600"  # segundos

# API Keys internas
INTERNAL_API_KEY="change_this_secure_api_key"

# -----------------------------------------------------------------------------
# Docker Configuration
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME="charo"
DOCKER_BUILDKIT="1"
COMPOSE_DOCKER_CLI_BUILD="1"

# -----------------------------------------------------------------------------
# Development/Debug
# -----------------------------------------------------------------------------
DEBUG_MODE="false"
ENABLE_AUDIO_RECORDING="false"  # Guardar grabaciones para debug
AUDIO_RECORDINGS_PATH="/data/recordings"
ENABLE_PROFILING="false"
PROFILE_OUTPUT_PATH="/data/profiles"

# Mock services (para testing sin hardware)
MOCK_AUDIO_INPUT="false"
MOCK_HOME_ASSISTANT="false"
MOCK_RUNPOD="false"

# -----------------------------------------------------------------------------
# NOTAS IMPORTANTES
# -----------------------------------------------------------------------------
# 1. Reemplaza TODOS los valores "your_*_here" con tus credenciales reales
# 2. Genera passwords seguros para POSTGRES_PASSWORD y JWT_SECRET
# 3. Nunca compartas tu archivo .env en repositorios públicos
# 4. Revisa los IPs de tus dispositivos con: nmap -sn 192.168.1.0/24
# 5. Para obtener el MAC del altavoz Bluetooth: bluetoothctl devices
# 6. Documentación completa en: docs/SETUP.md
# -----------------------------------------------------------------------------
