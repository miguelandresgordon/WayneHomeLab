# Copia a .env (gitignored) y rellena con TU cuenta de Mullvad:
#   https://mullvad.net/account/wireguard-config -> genera una clave -> copia
#   PrivateKey y Address. No commitees nunca .env.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
MULLVAD_COUNTRIES=Spain

# Límites (portátil). Para Raspberry Pi 3 (1 GB) usa .env.rpi3.example.
GLUETUN_MEM=128m
KALI_MEM=1g
KALI_CPUS=2.0
TOR_MEM=128m
JUICE_MEM=512m
DVWA_MEM=256m
DB_MEM=256m
WEBGOAT_MEM=768m
