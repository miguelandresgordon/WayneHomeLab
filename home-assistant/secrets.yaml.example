# ==============================================================================
# Home Assistant — Secrets Template
#
# Copy this file to secrets.yaml and fill in your actual values.
# NEVER commit secrets.yaml to version control.
#
#   cp secrets.yaml.example secrets.yaml
#
# ==============================================================================

# --- Location ---
timezone: "Europe/Madrid"
latitude: "40.4168"
longitude: "-3.7038"
elevation: "667"

# --- URLs ---
# internal: LAN / Satellite1 / ESPHome (HTTP)
# external: HTTPS via Caddy on WireGuard VPN only (docs/wireguard.md)
internal_url: "http://192.168.1.110:8123"
external_url: "https://ha.waynehomelab.com"

# --- API Keys ---
gemini_api_key: "YOUR_GEMINI_API_KEY_HERE"

# --- Wyoming Endpoints ---
wyoming_stt_host: "192.168.1.101"
wyoming_stt_port: "10300"
wyoming_tts_host: "192.168.1.101"
wyoming_tts_port: "10200"

# --- Network ---
mqtt_broker: "192.168.1.100"
mqtt_username: "mqtt_user"
mqtt_password: "YOUR_MQTT_PASSWORD_HERE"

# --- Notifications ---
# telegram_api_key: "YOUR_TELEGRAM_BOT_TOKEN"
# telegram_chat_id: "YOUR_CHAT_ID"
