# Minimal Pi-hole v6 config for unattended install (WayneHomelab).
# Copy to /etc/pihole/pihole.toml before running install_pihole.sh --unattended.
#
# Docs: https://docs.pi-hole.net/ftldns/configfile/
# Password: set via PIHOLE_WEBPASSWORD env or replace REPLACE_ME below.
# Do NOT commit a real password. See pihole.toml.example + .gitignore.

[dns]
  upstreams = [ "1.1.1.1", "1.0.0.1" ]
  # LOCAL = queries from local subnets only (recommended for LAN DNS)
  listeningMode = "LOCAL"
  # Do not enable Pi-hole DHCP — router keeps DHCP (reservas IoT).
  # dhcp.active = false  (default)

[webserver.api]
  # Plaintext is hashed on first start by FTL; replace REPLACE_ME or use install script.
  password = "REPLACE_ME"
