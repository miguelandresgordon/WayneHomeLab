# Porkbun API credentials for Caddy DNS-01 (Let's Encrypt).
# Copy to /etc/caddy/porkbun.env on the WireGuard VM (chmod 600).
# NEVER commit the real file.
#
# Create keys: https://porkbun.com/account/api
# Enable API Access for waynehomelab.com (Domain Details).
# DNS writes are free; Spend Controls only apply to register/renew/transfer.
#
# Do not use quotes around values.

PORKBUN_API_KEY=pk1_REPLACE_ME
PORKBUN_API_SECRET_KEY=sk1_REPLACE_ME
