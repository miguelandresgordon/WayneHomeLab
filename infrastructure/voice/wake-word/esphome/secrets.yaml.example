# ESPHome Device Builder secrets — HAOS: /config/esphome/secrets.yaml
# NO es el secrets.yaml de Home Assistant (/config/secrets.yaml).
# Never commit the real file.
#
# wifi_ssid / wifi_password: red 2.4 GHz (el ESP32 no ve 5 GHz).
# api_encryption_key: Noise PSK vivo. HA →
#   .storage/core.config_entries → domain esphome → data.noise_psk
#   (MAC 3c:0f:02:c7:ff:e4)

wifi_ssid: "REPLACE_WITH_2GHZ_SSID"
wifi_password: "REPLACE_WITH_WIFI_PASSWORD"
api_encryption_key: "REPLACE_WITH_HA_NOISE_PSK"
