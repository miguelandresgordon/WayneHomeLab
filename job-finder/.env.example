# ==============================================================================
# Job Finder — Environment Variables
#
# Copy to .env and customize:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==============================================================================

TZ=Europe/Madrid
JOB_FINDER_VERSION=0.1.0
LOG_LEVEL=info

# Bind: localhost for Mac dev. Production LAN: 192.168.1.100 or 0.0.0.0
JOB_FINDER_BIND=127.0.0.1
JOB_FINDER_PORT=8473

# SQLite on the compose volume (/data). Local pytest uses a temp file.
JOB_FINDER_DATABASE_URL=sqlite:////data/jobfinder.db

# CV storage (PDF only). Local pytest uses a temp dir.
JOB_FINDER_RESUMES_DIR=/data/resumes
JOB_FINDER_RESUME_MAX_BYTES=5242880

# Session signing / CSRF (change in every environment)
JOB_FINDER_SECRET_KEY=dev-only-change-me
JOB_FINDER_COOKIE_SECURE=false
JOB_FINDER_SESSION_HOURS=12

# Two household users (local/dev placeholders — change before any real data)
JOB_FINDER_USER_A_EMAIL=user-a@local.test
JOB_FINDER_USER_A_PASSWORD=change-me-a
JOB_FINDER_USER_B_EMAIL=user-b@local.test
JOB_FINDER_USER_B_PASSWORD=change-me-b

# Compose image tag (local build by default)
JOB_FINDER_IMAGE=job-finder:local
