# Home Assistant Secrets Example
# Copia este archivo a secrets.yaml y rellena con tus valores reales
# NUNCA commitees el archivo secrets.yaml real al repositorio

#################################
# HOME LOCATION
#################################
home_latitude: 40.4168  # Madrid - Ajusta a tu ubicación real
home_longitude: -3.7038
home_elevation: 650  # metros sobre el nivel del mar

#################################
# DATABASE
#################################
# PostgreSQL connection string para recorder
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
db_url: postgresql://homeassistant:tu_password_postgres@postgres:5432/homeassistant

#################################
# XIAOMI SMART BULB
#################################
# IP estática de la bombilla Xiaomi Yeelight
# Configura IP estática en tu router para este dispositivo
xiaomi_bulb_ip: 192.168.1.50

# Token de autenticación Xiaomi (opcional para algunas bombillas)
# Se obtiene con python-miio o app modificada
# xiaomi_token: 0123456789abcdef0123456789abcdef

#################################
# TUYA / SMART LIFE (Antela Bulbs)
#################################
# Credenciales de la app Smart Life
tuya_username: tu_email@ejemplo.com
tuya_password: tu_password_tuya

# Client ID y Secret de Tuya IoT Platform (opcional, para API local)
# Obténlos en https://iot.tuya.com/cloud/
# tuya_client_id: xxxxxxxxxxxxxxxxxx
# tuya_client_secret: yyyyyyyyyyyyyyyyyyyyyyyy

#################################
# SONY BRAVIA TV
#################################
# IP estática de la TV Sony
sony_tv_ip: 192.168.1.60

# Pre-Shared Key (PSK) de la TV
# Generado en: Settings > Network > Home Network > IP Control > Authentication
# Crea un PSK nuevo y cópialo aquí
sony_psk: 1234

#################################
# CHARO INTEGRATION
#################################
# URL del webhook de Charo Core Service
# Si charo-core está en el mismo host, usa el nombre del servicio Docker
charo_webhook_url: http://charo-core:8080/webhook/ha_response

# URL de notificaciones para Charo
charo_notify_url: http://charo-core:8080/notify

#################################
# EXTERNAL SERVICES (opcional)
#################################
# Nabu Casa (Home Assistant Cloud)
# nabu_casa_email: tu_email@ejemplo.com
# nabu_casa_password: tu_password

# DuckDNS (si usas acceso remoto)
# duckdns_domain: tu_dominio.duckdns.org
# duckdns_token: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Let's Encrypt (si usas SSL)
# letsencrypt_email: tu_email@ejemplo.com
