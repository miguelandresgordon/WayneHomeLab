# ==============================================================================
# Voice Pipeline — Environment Variables
#
# Copy to .env and customize:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==============================================================================

# --- General ---
TZ=Europe/Madrid

# --- Whisper (STT) ---
WHISPER_TAG=latest
WHISPER_PORT=10300
WHISPER_MODEL=tiny-int8
WHISPER_LANGUAGE=es
WHISPER_BEAM_SIZE=1

# --- Piper (TTS) ---
PIPER_TAG=latest
PIPER_PORT=10200
PIPER_VOICE=es_ES-davefx-medium
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8

# --- Available Whisper Models (by RPi capability) ---
# RPi 3b (1GB RAM):  tiny-int8, tiny
# RPi 4 (2-4GB RAM): base-int8, base, small-int8
# RPi 5 (4-8GB RAM): small, medium-int8

# --- Available Piper Voices (Spanish) ---
# es_ES-davefx-medium     (male, good quality)
# es_ES-sharvard-medium    (male, alternative)
# es_MX-ald-medium         (male, Mexican Spanish)
