# Weather Intelligence Center — copy to .env (never commit)

# --- Runtime (local Docker: WIC_DEMO=1) ---
WIC_PORT=3000
WIC_DB_PATH=./data/wic.db
# 1 = fixtures even if API keys exist (UI local sin AEMET)
WIC_DEMO=1

# --- Location (required for AEMET; do not reuse HA Madrid placeholders blindly) ---
WIC_LAT=40.4168
WIC_LON=-3.7038
WIC_ELEVATION=667
WIC_LOCATION_NAME=Casa
# Municipio INE 5 dígitos (Madrid capital = 28079)
WIC_MUNICIPIO_INE=28079
# Estación AEMET idema (Retiro = 3195)
WIC_IDEMA=3195
# Área avisos CAP (esp | código CCAA AEMET, Madrid=68, Galicia=71)
WIC_AEMET_AREA=68

# --- AEMET OpenData (https://opendata.aemet.es) ---
AEMET_API_KEY=

# --- Home Assistant ---
HA_BASE_URL=http://192.168.1.110:8123
HA_TOKEN=
# Optional: weather.* entity used only as fallback comparison
HA_WEATHER_ENTITY=weather.forecast_home

# --- Ingest HTTP (empty = only localhost may POST /api/ingest) ---
WIC_INGEST_TOKEN=
