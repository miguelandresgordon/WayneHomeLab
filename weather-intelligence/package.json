{
  "name": "weather-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "Weather Intelligence Center v1 slim — AEMET + Home Assistant",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "ingest": "tsx server/ingest.ts --once",
    "import": "tsx server/import-archive.ts",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.2",
    "hono": "^4.9.8",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
